{
  "expo": {
    "name": "Real Security Camera",
    "slug": "rsc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokenholdingsinc.realsecuritycamera",
      "infoPlist": {
        "NSCameraUsageDescription": "Real Security Camera uses your camera to record security footage and stream live video.",
        "NSMicrophoneUsageDescription": "Real Security Camera records audio alongside video for complete security coverage.",
        "NSPhotoLibraryUsageDescription": "Real Security Camera saves recordings to your photo library as a local backup.",
        "NSPhotoLibraryAddUsageDescription": "Real Security Camera saves recordings to your photo library.",
        "UIBackgroundModes": ["audio", "fetch", "processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.pokenholdingsinc.realsecuritycamera.upload"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E02020"
      },
      "package": "com.pokenholdingsinc.realsecuritycamera",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FLASHLIGHT",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-media-library",
      "expo-av",
      [
        "expo-background-fetch",
        {
          "startOnBoot": true
        }
      ],
      "@livekit/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "rsc-mobile"
      }
    }
  }
}
