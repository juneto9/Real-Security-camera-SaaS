{
  "expo": {
    "name": "Real Security Camera",
    "slug": "secure-camera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokenholdingsinc.realsecuritycamera",
      "infoPlist": {
        "NSCameraUsageDescription": "Real Security Camera uses your camera to record security footage and stream live video.",
        "NSMicrophoneUsageDescription": "Real Security Camera records audio alongside video for complete security coverage.",
        "NSPhotoLibraryUsageDescription": "Real Security Camera saves recordings to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Real Security Camera saves recordings to your photo library.",
        "NSLocalNetworkUsageDescription": "Real Security Camera scans your local network to discover and identify security cameras.",
        "NSBonjourServices": [
          "_onvif._tcp",
          "_rtsp._tcp",
          "_http._tcp"
        ],
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing",
          "location"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.pokenholdingsinc.realsecuritycamera.discovery"
        ],
        "NSLocationWhenInUseUsageDescription": "Real Security Camera uses your location to automatically arm cameras when you leave home.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Real Security Camera monitors your location in the background to auto-arm security cameras.",
        "NSUserNotificationUsageDescription": "Real Security Camera sends alerts when motion, sound, or known faces are detected."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E02020"
      },
      "package": "com.pokenholdingsinc.realsecuritycamera",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FLASHLIGHT",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-media-library",
      "expo-av",
      "@livekit/react-native",
      [
        "@react-native-community/netinfo",
        {
          "addAndroidPermissions": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RSC uses location for auto-arm geofencing."
        }
      ],
      "react-native-vision-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E02020",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9d90fdab-8c69-4cb3-9321-cd966274b8c0"
      }
    },
    "owner": "juneto9"
  }
}