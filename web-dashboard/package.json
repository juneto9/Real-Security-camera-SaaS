{
  "name": "real-security-camera-saas",
  "version": "1.0.0",
  "description": "Enterprise-grade mobile security camera system with real-time streaming, motion detection, and cloud recording",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:coverage": "jest --coverage",
    "migrate": "node database/runMigration.js",
    "seed": "node database/seedDatabase.js",
    "verify-schema": "node database/verifySchema.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t security-camera-saas:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env security-camera-saas:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "security",
    "camera",
    "saas",
    "streaming",
    "webrtc",
    "motion-detection"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "joi": "^17.10.0",
    "winston": "^3.11.0",
    "socket.io": "^4.6.1",
    "nodemailer": "^6.9.6",
    "aws-sdk": "^2.1500.0",
    "sharp": "^0.32.6",
    "ffmpeg-static": "^5.1.0",
    "wrtc": "^0.4.7",
    "uuid": "^9.0.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "dotenv-cli": "^7.3.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}